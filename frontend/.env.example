VITE_API_BASE_URL=/api
# Production defaults to https://trading-data.moritzknodler.com/NQ.
# Override this if you want another preprocessed data host.
# Expected files:
#   /sessions.json
#   /bars/YYYY-MM-DD.json
#   /prior-day-stats/YYYY-MM-DD.json
# VITE_MARKET_DATA_BASE_URL=https://your-server.example/trading-data/NQ

# Optional override for blind large-candle simulation packages.
# Production defaults to:
# https://trading-data.moritzknodler.com/NQ/simulations/large-candle/v1
# VITE_SIM_DATA_BASE_URL=https://your-server.example/trading-data/NQ/simulations/large-candle/v1
